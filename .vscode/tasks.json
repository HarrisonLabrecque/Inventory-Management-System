{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Inventory Management System",
            "type": "shell",
            "command": "C:\\msys64\\ucrt64\\bin\\g++.exe",
            "args": [
                "-std=c++17",
                "-g",
                "-I${workspaceFolder}\\include",
                "${workspaceFolder}\\main.cpp",
                "${workspaceFolder}\\src\\Product.cpp",
                "${workspaceFolder}\\src\\Supplier.cpp",
                "${workspaceFolder}\\src\\Category.cpp",
                "${workspaceFolder}\\src\\User.cpp",
                "${workspaceFolder}\\src\\Inventory.cpp",
                "${workspaceFolder}\\src\\Database.cpp",
                "${workspaceFolder}\\src\\FileManager.cpp",
                "-o",
                "${workspaceFolder}\\InventoryManagementSystem.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe build active file",
            "command": "C:\\msys64\\ucrt64\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ]
}